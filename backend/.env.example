# Copy this file to backend/.env and adjust values.
#
# MySQL: set MYSQL_PASSWORD to the real password for MYSQL_USER (required if root uses a password).
# Local dev without MySQL: set DB_BACKEND=sqlite (creates medical_assistant.db in backend/).

DB_BACKEND=mysql

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=medical_assistant

# SQLITE_PATH=medical_assistant.db

JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Optional: if unset or empty, the app uses rule-based mock AI responses
OPENAI_API_KEY=

# Optional OpenAI model (default gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Optional seeded admin account for the new admin dashboard
ADMIN_SEED_NAME=Admin
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Gmail SMTP for registration and password reset OTP.
# Use a Gmail App Password, not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-character-gmail-app-password
SMTP_FROM=your-gmail-address@gmail.com
SMTP_USE_TLS=true

# Recommended on Render — same as resend.com quickstart (do NOT commit real keys):
RESEND_API_KEY=re_your_key_here
RESEND_FROM=onboarding@resend.dev

OTP_EXPIRE_MINUTES=15
# Set true only on local dev to receive OTP in API JSON (never in production)
SHOW_OTP_IN_DEV=false

# Ephemeral health data: chats, logs, appointments, PDFs are purged after this many hours (default 24).
USER_DATA_RETENTION_HOURS=24
DATA_RETENTION_PURGE_INTERVAL_MINUTES=30
